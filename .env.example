# Copy to .env on the VPS (never commit real secrets).
# cp .env.example .env && nano .env

# MySQL (Docker service "db")
MYSQL_DATABASE=tcg_tools
MYSQL_USER=tcg
MYSQL_PASSWORD=change-me-strong-password
MYSQL_ROOT_PASSWORD=change-me-root-password

# Public URL for invite links and Secure cookies when https.
TCGTOOLS_PUBLIC_BASE_URL=https://torneios.exemplo.com

# production disables /docs and OpenAPI; development enables them.
TCGTOOLS_ENVIRONMENT=production

# Optional; defaults to true when TCGTOOLS_PUBLIC_BASE_URL starts with https://
# TCGTOOLS_COOKIE_SECURE=true

# First boot only: creates admin@local if missing. Remove after first login.
TCGTOOLS_BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password

# Caddy site address:
#   :80                        → HTTP on VPS IP
#   torneios.exemplo.com       → HTTPS (DNS A/AAAA must point to this VPS)
SITE_ADDRESS=:80
# ACME_EMAIL=admin@exemplo.com

TCGTOOLS_DB_WAIT_SEC=90

# Email (production SMTP — Hostinger). In development emails are logged to console.
TCGTOOLS_EMAIL_ENABLED=true
TCGTOOLS_EMAIL_FROM=Fourse <noreply@fourse.com.br>
TCGTOOLS_EMAIL_REPLY_TO=contato@fourse.com.br
TCGTOOLS_SMTP_HOST=smtp.hostinger.com
TCGTOOLS_SMTP_PORT=465
TCGTOOLS_SMTP_USER=noreply@fourse.com.br
TCGTOOLS_SMTP_PASSWORD=change-me-noreply-password
TCGTOOLS_SMTP_TLS=true

# Offsite backup (rclone + Google Drive). Configure remote: rclone config on VPS.
# BACKUP_RCLONE_REMOTE=tcg_backup
# BACKUP_RCLONE_PATH=tcg_tools-backups
